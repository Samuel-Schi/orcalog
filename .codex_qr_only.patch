+const QR_FIELD_ALIASES: Record<string, string> = {
+  UUID: 'UUID',
+  DESCRIPTION: 'DESCRIPTION',
+  LEGACYID: 'LEGACYID',
+  LEGACYLD: 'LEGACYID',
+  INVOICENUMBER: 'INVOICENUMBER',
